              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tipoResiduo\": \"latinhas\",\n  \"peso\": 2.5,\n  \"postoColeta\": \"centro\",\n  \"horario\": \"manha\",\n  \"dataEntrega\": \"2025-10-25\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/entregas",
              "host": ["{{baseUrl}}"],
              "path": ["entregas"]
            },
            "description": "Agenda uma entrega de resíduos. Tipos: latinhas (50pts/kg), plastico (20pts/kg), papel (15pts/kg), vidro (10pts/kg), metal (30pts/kg), eletronicos (100pts/kg). Postos: centro, jk, caic, camara. Horários: manha, tarde"
          }
        },
        {
          "name": "Minhas Entregas",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/entregas/minhas",
              "host": ["{{baseUrl}}"],
              "path": ["entregas", "minhas"]
            },
            "description": "Lista todas as entregas do usuário logado."
          }
        },
        {
          "name": "Listar Todas (Admin)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/entregas",
              "host": ["{{baseUrl}}"],
              "path": ["entregas"]
            },
            "description": "Lista todas as entregas. Apenas admins."
          }
        },
        {
          "name": "Confirmar Entrega (Admin)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "PUT",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/entregas/:id/confirmar",
              "host": ["{{baseUrl}}"],
              "path": ["entregas", ":id", "confirmar"],
              "variable": [
                {
                  "key": "id",
                  "value": "ID_DA_ENTREGA"
                }
              ]
            },
            "description": "Confirma a entrega e adiciona os pontos ao usuário. Apenas admins podem confirmar."
          }
        },
        {
          "name": "Cancelar Entrega",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "PUT",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/entregas/:id/cancelar",
              "host": ["{{baseUrl}}"],
              "path": ["entregas", ":id", "cancelar"],
              "variable": [
                {
                  "key": "id",
                  "value": "ID_DA_ENTREGA"
                }
              ]
            },
            "description": "Cancela uma entrega agendada. Usuário pode cancelar apenas suas próprias entregas."
          }
        },
        {
          "name": "Estatísticas (Admin)",
          "request": {
            "auth": {
